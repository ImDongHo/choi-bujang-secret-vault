{
  "schema": "aleph.policy.v1",
  "version": "step8-verified-b9d601a",
  "verifiedAt": "2026-10-13",
  "note": "8단계 심판 통과 커밋 b9d601a의 판정기·자료 API 구역 규칙을 옮긴 안전 사본입니다. allow: owner(저장된 주인만), instructor(저장된 강사만), session(로그인 경로), none(누구도 안 됨).",
  "services": {
    "notes": [
      { "route": "GET /notes", "allow": "none" },
      { "route": "POST /notes", "allow": "owner" },
      { "route": "GET /notes/:id", "allow": "owner" },
      { "route": "PUT /notes/:id", "allow": "owner" },
      { "route": "DELETE /notes/:id", "allow": "owner" }
    ],
    "notices": [
      { "route": "GET /notices", "allow": "instructor" },
      { "route": "GET /notices/:id", "allow": "instructor" },
      { "route": "PUT /notices/:id", "allow": "instructor" }
    ],
    "auth": [
      { "route": "POST /auth/login", "allow": "session" },
      { "route": "POST /auth/refresh", "allow": "session" },
      { "route": "POST /auth/logout", "allow": "session" }
    ]
  }
}
